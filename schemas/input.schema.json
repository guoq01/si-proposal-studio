{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/si-proposal-studio/input.schema.json",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "draft",
        "revise",
        "derive"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "zh"
      ]
    },
    "journal": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "abbr": {
          "type": "string",
          "minLength": 1
        },
        "url_scope": {
          "type": "string",
          "minLength": 1
        },
        "special_rules": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "full_name",
        "abbr",
        "url_scope",
        "special_rules"
      ],
      "additionalProperties": false
    },
    "si_title_draft": {
      "type": "string",
      "minLength": 1
    },
    "research_topic": {
      "type": "string",
      "minLength": 1
    },
    "core_scientific_gaps": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "guest_editors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "affiliation": {
            "type": "string",
            "minLength": 1
          },
          "bio": {
            "type": "string",
            "minLength": 1
          },
          "org_experience": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 1
          },
          "orcid": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "lead",
              "co_guest_editor"
            ]
          },
          "consent_status": {
            "type": "string",
            "enum": [
              "confirmed",
              "pending"
            ]
          },
          "evidence_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "affiliation",
          "bio",
          "org_experience"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "intended_timeline": {
      "type": "object",
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "window": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "evidence_source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "tentative",
            "confirmed"
          ]
        }
      },
      "required": [
        "milestones",
        "status"
      ],
      "additionalProperties": false
    },
    "source_community": {
      "type": "string",
      "minLength": 1
    },
    "expected_submissions": {
      "type": "integer",
      "minimum": 1
    },
    "user_constraints": {
      "type": "string",
      "minLength": 1
    },
    "source_proposal": {
      "type": "string"
    },
    "editor_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "comment"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cfp",
          "cover_letter",
          "teaser",
          "promotion"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "include_cfp": {
      "type": "boolean"
    },
    "submission_url": {
      "type": "string",
      "minLength": 1
    },
    "source_proposal_version": {
      "type": "string",
      "minLength": 1
    },
    "fact_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "user_confirmed",
              "verified",
              "pending"
            ]
          }
        },
        "required": [
          "id",
          "field",
          "source",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "journal_specific": {
      "type": "object",
      "additionalProperties": true
    },
    "derivative_constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "draft_stage": {
      "type": "string",
      "enum": [
        "auto",
        "discover",
        "write"
      ]
    },
    "discovery_preferences": {
      "type": "object",
      "properties": {
        "preferred_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lookback_years": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "topic_selection": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "report_digest": {
          "type": "string",
          "minLength": 1
        },
        "user_confirmation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "candidate_id",
        "report_digest",
        "user_confirmation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "journal",
    "si_title_draft",
    "research_topic",
    "core_scientific_gaps",
    "keywords",
    "guest_editors",
    "intended_timeline",
    "source_community",
    "expected_submissions",
    "user_constraints"
  ],
  "additionalProperties": false
}
